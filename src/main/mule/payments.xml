				</ee:set-variable>
				<ee:set-variable variableName="extApiName"><![CDATA[%dw 2.0
					output application/java
					---
					p('external.systemapi.azuresql')]]>
				</ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="SystemApiCall" doc:id="e1378c89-3702-4a35-a5fb-c1b4a7b9dfb2" name="systemApiCallSubFlow" />
		<ee:transform doc:name="PaymentReceiptRes" doc:id="b2d6eb00-a928-42f7-93bd-b06732807978">
			<ee:variables>
				<ee:set-variable variableName="logMsg" resource="dwl/logMsg.dwl" />
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="ResLog" doc:id="3fdf7de0-dc8a-41c3-9010-1dd080496310" name="commonLoggingExitSubFlow" />
	</sub-flow>

</mule>
