		<ee:transform doc:name="SetVars" doc:id="50843f53-a53c-43e2-a85e-e66d68389ad9">
			<ee:variables>
				<ee:set-variable variableName="systemapi"><![CDATA[%dw 2.0
					output application/java
					---
					{
						host: p('secure::systemapi.azuresql.host'),
