	<!-- CREATE PAYMENTS RECEIPT SUB FLOW -->
	<sub-flow name="createPaymentsReceiptSubFlow" doc:id="73374b75-1122-4129-b4dc-7e3b5ad80a6a">
		<ee:transform doc:name="Entity">
			<ee:variables>
				<ee:set-variable variableName="entity"><![CDATA[%dw 2.0
					output application/java
					---
					'createPaymentsReceipt' ]]>
				</ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="StartLog" doc:id="cb0caa8f-d16d-4dd1-baa9-f31059d54a69" name="commonLoggingEntrySubFlow" />
		<ee:transform doc:name="SetVars" doc:id="4faf1e69-51d6-4f9a-986f-c624db927412">
			<ee:variables>
				<ee:set-variable variableName="systemapi"><![CDATA[%dw 2.0
					output application/java
					---
					{
						host: p('secure::systemapi.azuresql.host'),
						port: p('secure::systemapi.azuresql.port'),
						basePath: p('systemapi.azuresql.basePath') default '',
						entityPath: p('systemapi.azuresql.path.payments.receipt'),
						clientId: p('secure::systemapi.azuresql.clientId'),
						clientSecret: p('secure::systemapi.azuresql.clientSecret'),
						(queryParams: attributes.queryParams) if (!isEmpty(attributes.queryParams)),
						headers: { userId: attributes.headers.'userId' }
					}]]>
				</ee:set-variable>
				<ee:set-variable variableName="httpMethod"><![CDATA[%dw 2.0
					output application/java
					---
					'POST']]>
				</ee:set-variable>
				<ee:set-variable variableName="extApiName"><![CDATA[%dw 2.0
					output application/java
					---
					p('external.systemapi.azuresql')]]>
				</ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="SystemApiCall" doc:id="8e426017-8d5a-4bc1-934e-549a8501a93d" name="systemApiCallSubFlow" />
		<ee:transform doc:name="PaymentReceiptRes" doc:id="c9236ba2-d338-4377-932f-de8c0b24c928">
			<ee:variables>
				<ee:set-variable variableName="logMsg" resource="dwl/logMsg.dwl" />
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="ResLog" doc:id="5f3cbf76-7752-4fd8-91e7-e5a06915c00d" name="commonLoggingExitSubFlow" />
	</sub-flow>

